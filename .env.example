# ============================================================================
# IT RAINS MINISTRIES — environment variables
# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables for production.
# Variables starting with NEXT_PUBLIC_ are visible in the browser; never put secrets in them.
# ============================================================================

# Public URL of the site (no trailing slash). Used in emails, payment redirects and SEO.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (REQUIRED: database, login, realtime chat, file storage) -------
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (card, Apple Pay, Google Pay, monthly giving) --------------------
# Stripe dashboard → Developers → API keys. Use sk_test_… while testing.
STRIPE_SECRET_KEY=
# Developers → Webhooks → endpoint https://YOUR-DOMAIN/api/webhooks/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         invoice.paid, charge.refunded, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=

# --- PayPal (one-time gifts) --------------------------------------------------
# developer.paypal.com → Apps & Credentials → create a REST app
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox            # change to "live" for real payments

# --- Email (Resend) -----------------------------------------------------------
# resend.com → API Keys. Verify your domain in Resend to send from it.
RESEND_API_KEY=
EMAIL_FROM="IT RAINS MINISTRIES <no-reply@yourdomain.org>"
# Where new prayer requests, messages and testimonies are announced to staff
MINISTRY_INBOX_EMAIL=

# --- Live streaming (LiveKit Cloud) -------------------------------------------
# cloud.livekit.io → your project → Settings → Keys
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# In LiveKit project settings → Webhooks, add https://YOUR-DOMAIN/api/webhooks/livekit

# --- Automatic recording of broadcasts (any S3-compatible storage) ------------
# Supabase: Storage → S3 Connection → create access keys. Endpoint looks like
# https://<project-ref>.supabase.co/storage/v1/s3 ; bucket "recordings" is created by the migration.
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET=
RECORDING_S3_BUCKET=recordings
RECORDING_S3_REGION=us-east-1
RECORDING_S3_ENDPOINT=
# Optional: public base URL if recordings bucket is public / behind a CDN.
# Leave empty to serve recordings through short-lived signed links (recommended).
RECORDING_PUBLIC_BASE_URL=

# --- Web push notifications ("Notify me when we go live") ---------------------
# Generate once with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@yourdomain.org

# --- Optional -----------------------------------------------------------------
# Cloudflare Turnstile anti-spam (dash.cloudflare.com → Turnstile). Honeypot + rate limits work without it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Google Analytics 4 measurement ID (G-XXXXXXX). Loads only after a visitor accepts analytics cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Maps Embed API key (optional; a keyless map embed is used otherwise)
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Public (browser-safe) Supabase values. Find them in Supabase > Project Settings > API.
# The anon/publishable key is designed to be public; Row Level Security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# NEVER put these in a VITE_ variable or in this file. They belong in Supabase Edge Function secrets:
#   SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY, PAYPAL_CLIENT_SECRET, RESTREAM_CLIENT_SECRET,
#   RESEND_API_KEY, TWILIO_AUTH_TOKEN, stream keys.
